# Database Configuration - Primary database: PostgreSQL (required; the app will NOT silently fall back to SQLite)
# For lightweight dev/test ONLY you may set an explicit SQLite URL, e.g. DATABASE_URL=sqlite:///./textile_waste.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/textile_db
MONGODB_URL=mongodb://localhost:27017/textile_intelligence

# JWT Authentication Security
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Security Configuration (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=10

# Deployment Environment (development / staging / production)
ENVIRONMENT=development

# EfficientNet-B0 fabric classifier checkpoint. Leave unset until training finishes.
FABRIC_MODEL_PATH=../models/best_efficientnet_b0_no_weights.pth
